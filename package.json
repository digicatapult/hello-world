{
  "name": "hello-world",
  "version": "2.0.1",
  "description": "A minimally-useful NPM package",
  "homepage": "https://github.com/digicatapult/hello-world#readme",
  "bugs": {
    "url": "https://github.com/digicatapult/hello-world/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digicatapult/hello-world.git"
  },
  "license": "ISC",
  "author": "Digital Catapult",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test:init": "node src/index.js",
    "test:playwright": "NODE_ENV=test playwright test --trace on --max-failures=1",
    "db:cmd": "node ./node_modules/knex/bin/cli.js",
    "db:migrate": "npm run db:cmd -- migrate:latest",
    "db:rollback": "npm run db:cmd -- migrate:rollback",
    "db:seed": "npm run db:cmd -- seed:run"
  },
  "dependencies": {
    "express": "^5.2.1",
    "knex": "^3.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.0.10",
    "playwright-ctrf-json-reporter": "^0.0.27"
  }
}
